# Upstream source checkout (recreated by build.ps1)
/Pumpkin/

# Mojang's server jar: not redistributable
/vanilla/
*.jar

# Built binaries
*.exe
*.pdb

# Runtime state: worlds, logs, player data and private keys
/server/*
!/server/pumpkin.toml
!/server/start.bat
!/server/start.sh
!/server/pumpkin.service
*.der
*.key


# ViaProxy runtime (jar, config with secret, plugin data, logs) and plugin build output
/via/run/
/via/plugin/build/
/via/PumpkinForward.jar

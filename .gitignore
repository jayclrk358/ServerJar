# Upstream source checkout (recreated by build.ps1)
/Pumpkin/

# Mojang's server jar: not redistributable
/vanilla/
*.jar

# Built binaries
*.exe
*.pdb

# Runtime state: worlds, logs, player data and private keys
/server/*
!/server/pumpkin.toml
!/server/start.bat
!/server/start.sh
!/server/pumpkin.service
*.der
*.key


# Plugin build output
/plugins/perfmon/target/
/server/.panel-auth.json
/server/.panel-cert.pem
/server/.panel-key.pem
